# .env.example - Template for environment variables
# Copy this file to .env and fill in your actual values

# ============================================================================
# MySQL Database Credentials
# ============================================================================
DB_HOST=your_database_host.com
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_username
DB_PASSWORD=your_database_password

# ============================================================================
# JSON File Configuration (for Company URL Finder)
# ============================================================================
COMPANIES_JSON_FILE=json/companies/company_namess.json

# ============================================================================
# Company URL Finder Configuration
# ============================================================================
# Maximum number of company names to search
MAX_NAMES_TO_SEARCH=1000

# Maximum number of sub URLs to extract per company
MAX_SUB_URLS=5

# Maximum number of additional URLs to discover
MAX_ADDITIONAL_URLS=10

# Run browser in headless mode (true/false)
HEADLESS_MODE=false

# ============================================================================
# Contact Form Scraper Configuration
# ============================================================================
# Maximum number of companies to crawl in one session
MAX_COMPANIES_TO_CRAWL=800

# Maximum number of pages to visit per company
MAX_PAGES_PER_COMPANY=20

# Delay between requests in seconds (to avoid rate limiting)
CRAWL_DELAY=1

# Request timeout in seconds
REQUEST_TIMEOUT=12
